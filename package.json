{
  "name": "myas-task-tracker",
  "version": "0.1.0",
  "private": true,
  "description": "Mobile-first task and workflow management tool for the Joint Secretary's office, Ministry of Youth Affairs & Sports.",
  "scripts": {
    "dev": "next dev",
    "postinstall": "prisma generate",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:document-centre": "tsx prisma/seed-document-centre.ts",
    "db:seed:business-cards": "tsx prisma/seed-business-cards.ts",
    "db:studio": "prisma studio"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.609.0",
    "@aws-sdk/s3-request-presigner": "^3.609.0",
    "@google-analytics/data": "^6.1.0",
    "@prisma/client": "5.18.0",
    "@tabler/icons-webfont": "2.44.0",
    "argon2": "0.44.0",
    "bcryptjs": "2.4.3",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "next": "14.2.35",
    "next-auth": "5.0.0-beta.31",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "sortablejs": "^1.15.2",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.14.10",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/sortablejs": "^1.15.8",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.57.0",
    "eslint-config-next": "14.2.5",
    "postcss": "^8.4.39",
    "prisma": "5.18.0",
    "tailwindcss": "^3.4.6",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3",
    "vitest": "^2.1.9"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "argon2",
      "esbuild",
      "prisma",
      "protobufjs",
      "unrs-resolver"
    ]
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
